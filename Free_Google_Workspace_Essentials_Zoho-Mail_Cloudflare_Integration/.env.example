# Sentinel-RS 環境變數範例（複製為 .env，勿提交 .env）

# Google Admin SDK (Service Account + Domain-Wide Delegation)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# 或內嵌 JSON 字串：
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
GOOGLE_ADMIN_DELEGATE_USER=admin@dennisleehappy.org

# Zoho Mail 組織 API
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=

# Cloudflare（階段 5 使用）
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=

# 可選：自訂設定檔路徑
# SENTINEL_CONFIG=/path/to/config.toml
